{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@syntest/diagnostics": [
                "./syntest-type-inference/vendor/diagnostics/index.ts"
            ],
            "@syntest/logging": [
                "./syntest-type-inference/vendor/logging/index.ts"
            ],
            "@syntest/prng": [
                "./syntest-type-inference/vendor/prng/index.ts"
            ],
            "@syntest/ast-visitor-javascript": [
                "./syntest-type-inference/vendor/ast-visitor-javascript/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "temp-typescript-repo",
        "syntest-type-inference"
    ]
}